# Supabase project URL and publishable (anon) key. Never put a service-role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# MediMind API. Defaults to the hosted Render backend when unset.
EXPO_PUBLIC_API_URL=https://medimind-backend-8mbb.onrender.com
